.DS_Store
*.bak
node_modules/
/.claude/

# Playwright test artefacts (closes #116). The framework dogfoods its
# own Playwright extension on docs/walkthrough.html + Tier 3 wireframe.
# These directories regenerate on every test run; not for committing.
/playwright-report/
/test-results/
/playwright/.cache/


# Local Obsidian vault state (templates/.obsidian/ is shipped; root .obsidian/ is per-user)
/.obsidian/
# Stale per-project graph cache that the test suite occasionally writes
# into the extension dir. Narrowed (CR cycle-9): previously ignored the
# whole `.sdd/` subtree which would have hidden any legitimate file added
# under the extension. Only the cache dir is a test artefact.
/extensions/sdd-mcp-server/.sdd/.cache/

# Root-level CLAUDE.md — the framework's local working copy of the
# canonical templates/CLAUDE.md. Stays untracked so each clone /
# session can have its own (or copy from templates/CLAUDE.md on
# first session). Without this, every commit cycle has a stale
# 'Warning: 1 uncommitted change' on PR creation.
/CLAUDE.md
.sdd/.cache/last-warnings.txt

# Per-session SDD state (surfaced during F008 SHIP):
# - .advance.last-head: per-session phase-advance pointer written by
#   .sdd/scripts/advance.sh; reflects the last seen HEAD, not project state.
# - metrics.md: per-developer action-run TSV log written by /next; not a
#   shared artefact (each contributor accumulates their own).
.sdd/.advance.last-head
.sdd/metrics.md

# Local npm-pack output for the pi.dev extension (F008). The tarball is
# generated for manual install testing (`pi install file:./*.tgz`); the
# release path is tag-driven via .github/workflows/publish-pi-adapter.yml,
# so the .tgz never needs to live in git.
extensions/sdd-pi-extension/*.tgz
