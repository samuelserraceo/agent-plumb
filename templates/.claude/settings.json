{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/user-prompt-submit.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/triage-on-first-message.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-rules.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-stage-verified.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-no-assumed-markers.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-no-theatre.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-test-first.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-stop-lint.sh"
          }
        ]
      }
    ]
  }
}
