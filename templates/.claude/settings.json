{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/user-prompt-submit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-block.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-learn-sync.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-schema-sync.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-scope-guard.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-claude-md-managed.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-size-cap.sh"
          }
        ]
      }
    ]
  }
}
