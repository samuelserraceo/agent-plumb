{
  "collapse-filter": false,
  "search": "-path:.git -path:.cache -path:.claude -path:templates -path:test -path:node_modules",
  "showTags": false,
  "showAttachments": false,
  "hideUnresolved": false,
  "showOrphans": true,
  "collapse-color-groups": false,
  "colorGroups": [
    {
      "query": "path:.sdd/features",
      "color": {
        "a": 1,
        "rgb": 16113163
      }
    },
    {
      "query": "path:.sdd/decisions.md",
      "color": {
        "a": 1,
        "rgb": 3901942
      }
    },
    {
      "query": "path:.sdd/patterns.md",
      "color": {
        "a": 1,
        "rgb": 1095033
      }
    },
    {
      "query": "path:.sdd/data-model.md",
      "color": {
        "a": 1,
        "rgb": 9132790
      }
    },
    {
      "query": "path:.sdd/playbooks",
      "color": {
        "a": 1,
        "rgb": 14855196
      }
    },
    {
      "query": "path:.sdd/actions",
      "color": {
        "a": 1,
        "rgb": 6730495
      }
    }
  ],
  "collapse-display": false,
  "showArrow": true,
  "textFadeMultiplier": 0,
  "nodeSizeMultiplier": 1.2,
  "lineSizeMultiplier": 1,
  "collapse-forces": false,
  "centerStrength": 0.5,
  "repelStrength": 12,
  "linkStrength": 1,
  "linkDistance": 250,
  "scale": 0.6,
  "close": false
}
